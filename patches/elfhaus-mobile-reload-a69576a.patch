+
+export function watchCanvas(cv: HTMLCanvasElement | null | undefined, name: string) {
+	if (!cv || (cv as HTMLCanvasElement & { __ehWatch?: boolean }).__ehWatch) return;
+	(cv as HTMLCanvasElement & { __ehWatch?: boolean }).__ehWatch = true;
